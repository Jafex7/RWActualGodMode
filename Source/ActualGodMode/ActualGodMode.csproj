<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ActualGodMode</RootNamespace>
    <AssemblyName>ActualGodMode</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- RimWorld 1.7 / Waylith requirements -->
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>

    <!-- Override with: dotnet build -p:RimWorldPath="D:\path\to\RimWorld" -->
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">F:\SteamLibrary\steamapps\common\RimWorld</RimWorldPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldPath)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldPath)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-time only; the Harmony mod (brrainz.harmony) supplies 0Harmony.dll at runtime -->
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.5" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
