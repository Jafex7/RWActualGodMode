<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Reactions to being lifted by the god's hand. Flavor: small, one at a time, short. -->
  <ThoughtDef>
    <defName>AGM_LiftedJoy</defName>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>lifted by the god</label>
        <description>The god's hand held me up, gently, like a child. I've never felt so safe.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>AGM_LiftedStartled</defName>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>picked up by something unseen</label>
        <description>Something lifted me right off the ground. What was that?</description>
        <baseMoodEffect>0</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>AGM_LiftedFear</defName>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>seized by the god</label>
        <description>It grabbed me like a toy. I could feel how easily it could crush me.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
