<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Drop rules: what a colonist set down by the god's hand does with what's under them.
       A tree like the storage filter; each category lists the actions that make sense for it.
       The player's choice is saved per game (DropRules); a category with nothing set takes its
       parent's action. Defaults are Work (the first assigned work there, as without rules).
       What they're set on: the top thing on the cell, else filth, else the ground. -->

  <!-- ===== Items ===== -->
  <ActualGodMode.DropCategoryDef>
    <defName>AGM_Drop_Items</defName>
    <label>items</label>
    <description>Anything that can be carried: resources, food, apparel, weapons, corpses...</description>
    <order>10</order>
    <workerClass>ActualGodMode.DropCategoryWorker_Item</workerClass>
    <actions><li>Work</li><li>Haul</li><li>Ignore</li></actions>
  </ActualGodMode.DropCategoryDef>

  <ActualGodMode.DropCategoryDef>
    <defName>AGM_Drop_Apparel</defName>
    <label>apparel</label>
    <parent>AGM_Drop_Items</parent>
    <order>10</order>
    <workerClass>ActualGodMode.DropCategoryWorker_Item</workerClass>
    <thingCategories><li>Apparel</li></thingCategories>
    <actions><li>Wear</li><li>Work</li><li>Haul</li><li>Ignore</li></actions>
  </ActualGodMode.DropCategoryDef>

