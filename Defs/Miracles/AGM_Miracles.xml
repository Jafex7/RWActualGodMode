<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <MainButtonDef>
    <defName>AGM_Miracles</defName>
    <label>miracles</label>
    <description>Work miracles inside your influence, paid for with Divine Power.</description>
    <workerClass>ActualGodMode.MainButtonWorker_Miracles</workerClass>
    <tabWindowClass>ActualGodMode.MainTabWindow_Miracles</tabWindowClass>
    <order>75</order>
    <closesWorldView>true</closesWorldView>
  </MainButtonDef>

  <!-- ===== Water ===== -->
  <ActualGodMode.MiracleDef>
    <defName>AGM_Miracle_Water</defName>
    <label>water</label>
    <description>Rain falls where the god's hand passes, putting out fires and soaking the ground. Hold and drag to pour it tile by tile.</description>
    <workerClass>ActualGodMode.MiracleWorker_Water</workerClass>
    <gesture>AGM_Gesture_Wave</gesture>
    <iconThing>Filth_Water</iconThing>
    <order>10</order>
    <!-- Pour-only: hold and drag to water `amount` tiles, one at a time (a tile counts once).
         Release pauses, press again to go on, right-click cancels. No time limit. -->
    <channel>
      <pourOnly>true</pourOnly>
      <perTile>true</perTile>
    </channel>
    <levels>
      <li>
        <label>I</label>
        <cost>5</cost>
        <amount>9</amount>
      </li>
      <li>
        <label>II</label>
        <cost>15</cost>
        <amount>16</amount>
        <requirements>
          <li Class="ActualGodMode.Req_Believers">
            <count>3</count>
          </li>
        </requirements>
      </li>
    </levels>
  </ActualGodMode.MiracleDef>

  <!-- ===== Food ===== -->
  <ActualGodMode.MiracleDef>
    <defName>AGM_Miracle_Food</defName>
    <label>food</label>
    <description>Food appears from nowhere. A small blessing feeds one person for a day; a greater one feeds a household.</description>
    <workerClass>ActualGodMode.MiracleWorker_SpawnThing</workerClass>
    <gesture>AGM_Gesture_Circle</gesture>
    <iconThing>MealSimple</iconThing>
    <order>20</order>
    <!-- Hold the click: raw crops fall one handful at a time. -->
    <channel>
      <maxSeconds>2</maxSeconds>
      <unitsPerSecond>6</unitsPerSecond>
      <unitCost>1.2</unitCost>
      <countPerUnit>5</countPerUnit>
      <things>
        <li>RawPotatoes</li>
        <li>RawCorn</li>
        <li>RawRice</li>
      </things>
    </channel>
    <levels>
      <li>
        <label>I</label>
        <cost>10</cost>
        <thingDef>MealSimple</thingDef>
        <amount>2</amount>
      </li>
      <li>
        <label>II</label>
        <cost>30</cost>
        <thingDef>MealSimple</thingDef>
        <amount>6</amount>
        <requirements>
          <li Class="ActualGodMode.Req_Believers">
            <count>3</count>
          </li>
          <li Class="ActualGodMode.Req_LifetimePower">
            <amount>150</amount>
          </li>
        </requirements>
      </li>
    </levels>
  </ActualGodMode.MiracleDef>

  <!-- ===== Heal ===== -->
  <ActualGodMode.MiracleDef>
    <defName>AGM_Miracle_Heal</defName>
    <label>heal</label>
    <description>Mend one person's worst wounds. It eases pain and slows bleeding, often enough to get the fallen back on their feet, but the wounds still need a doctor's care.</description>
    <workerClass>ActualGodMode.MiracleWorker_Heal</workerClass>
    <gesture>AGM_Gesture_Cross</gesture>
    <iconThing>MedicineHerbal</iconThing>
    <order>15</order>
    <levels>
      <li>
        <label>I</label>
        <cost>15</cost>
        <amount>10</amount>
        <requirements>
          <li Class="ActualGodMode.Req_EventOccurred">
            <eventKey>ColonistDowned</eventKey>
            <descriptionKey>AGM_Req_Event_ColonistDowned</descriptionKey>
          </li>
        </requirements>
      </li>
    </levels>
  </ActualGodMode.MiracleDef>

  <!-- ===== Wood ===== -->
  <ActualGodMode.MiracleDef>
    <defName>AGM_Miracle_Wood</defName>
    <label>wood</label>
    <description>Logs fall one by one while the god's hand is held over the spot. A small blessing is enough for a campfire.</description>
    <workerClass>ActualGodMode.MiracleWorker_SpawnThing</workerClass>
    <gesture>AGM_Gesture_Tree</gesture>
    <iconThing>WoodLog</iconThing>
    <order>30</order>
    <!-- Pour-only: hold to drop the level's logs one by one; the full amount takes pourSeconds of holding.
         Release pauses, press again to go on, right-click cancels. -->
    <channel>
      <pourOnly>true</pourOnly>
      <pourSeconds>3</pourSeconds>
    </channel>
    <levels>
      <li>
        <label>I</label>
        <cost>5</cost>
        <thingDef>WoodLog</thingDef>
        <amount>25</amount>
      </li>
      <li>
        <label>II</label>
        <cost>12</cost>
        <thingDef>WoodLog</thingDef>
        <amount>75</amount>
        <requirements>
          <li Class="ActualGodMode.Req_LifetimePower">
            <amount>100</amount>
          </li>
        </requirements>
      </li>
    </levels>
  </ActualGodMode.MiracleDef>

</Defs>
