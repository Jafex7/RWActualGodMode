<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <MainButtonDef>
    <defName>AGM_Miracles</defName>
    <label>miracles</label>
    <description>Work miracles inside your influence, paid for with Divine Power.</description>
    <workerClass>ActualGodMode.MainButtonWorker_Miracles</workerClass>
    <tabWindowClass>ActualGodMode.MainTabWindow_Miracles</tabWindowClass>
    <order>75</order>
    <closesWorldView>true</closesWorldView>
  </MainButtonDef>

  <!-- Miracles have no levels: each is one miracle with its own numbers (cost, amount, ...),
       which god-progression upgrades will raise later. Poured miracles (<channel>) are cast by
       holding the click in the god's hand: the charge is the full effect (amount units), paid
       per unit (cost / units); release pauses, press again to go on, right-click cancels. -->

  <!-- ===== Water ===== -->
  <ActualGodMode.MiracleDef>
    <defName>AGM_Miracle_Water</defName>
    <label>water</label>
    <description>Rain falls where the god's hand passes, putting out fires and soaking the ground. Hold and drag to pour it tile by tile.</description>
    <workerClass>ActualGodMode.MiracleWorker_Water</workerClass>
    <gesture>AGM_Gesture_Wave</gesture>
    <iconThing>Filth_Water</iconThing>
    <order>10</order>
    <cost>5</cost>
    <amount>9</amount>
    <unitLabel>tiles</unitLabel>
    <!-- One tile at a time, no time limit; a tile counts once. -->
    <channel>
      <perTile>true</perTile>
    </channel>
  </ActualGodMode.MiracleDef>

  <!-- ===== Food ===== -->
  <ActualGodMode.MiracleDef>
    <defName>AGM_Miracle_Food</defName>
    <label>food</label>
    <description>Blessed crops fall one by one while the god's hand is held over the spot: a day's food for one if eaten raw, two meals if cooked. Blessed food (and meals cooked from it) gives faith to those who eat it.</description>
    <workerClass>ActualGodMode.MiracleWorker_SpawnThing</workerClass>
    <gesture>AGM_Gesture_Circle</gesture>
    <iconThing>RawPotatoes</iconThing>
    <order>20</order>
    <cost>10</cost>
    <amount>20</amount>
    <unitLabel>crops</unitLabel>
    <!-- 20 crops = 1 nutrition, one at a time over 3 s of holding: eaten raw a quick fix, cooked two simple meals. -->
    <channel>
      <pourSeconds>3</pourSeconds>
      <things>
        <li>RawPotatoes</li>
        <li>RawCorn</li>
        <li>RawRice</li>
      </things>
    </channel>
  </ActualGodMode.MiracleDef>

  <!-- ===== Heal ===== -->
  <ActualGodMode.MiracleDef>
    <defName>AGM_Miracle_Heal</defName>
    <label>heal</label>
    <description>Mend one person's worst wounds. Hold the hand over them: it eases pain and slows bleeding, often enough to get the fallen back on their feet, but the wounds still need a doctor's care. Only what heals is paid.</description>
    <workerClass>ActualGodMode.MiracleWorker_Heal</workerClass>
    <gesture>AGM_Gesture_Cross</gesture>
    <iconThing>MedicineHerbal</iconThing>
    <order>15</order>
    <cost>15</cost>
    <amount>10</amount>
    <unitLabel>severity</unitLabel>
    <!-- One point of severity at a time on the first pawn touched, over 3 s of holding; it stops when nothing is left to heal. -->
    <channel>
      <pourSeconds>3</pourSeconds>
      <lockTarget>true</lockTarget>
    </channel>
    <requirements>
      <li Class="ActualGodMode.Req_EventOccurred">
        <eventKey>ColonistDowned</eventKey>
        <descriptionKey>AGM_Req_Event_ColonistDowned</descriptionKey>
      </li>
    </requirements>
  </ActualGodMode.MiracleDef>

  <!-- ===== Wood ===== -->
  <ActualGodMode.MiracleDef>
    <defName>AGM_Miracle_Wood</defName>
    <label>wood</label>
    <description>Logs fall one by one while the god's hand is held over the spot. A small blessing is enough for a campfire.</description>
    <workerClass>ActualGodMode.MiracleWorker_SpawnThing</workerClass>
    <gesture>AGM_Gesture_Tree</gesture>
    <iconThing>WoodLog</iconThing>
    <order>30</order>
    <cost>5</cost>
    <thingDef>WoodLog</thingDef>
    <amount>25</amount>
    <unitLabel>logs</unitLabel>
    <!-- One log at a time; the full amount takes 3 s of holding. -->
    <channel>
      <pourSeconds>3</pourSeconds>
    </channel>
  </ActualGodMode.MiracleDef>

</Defs>
