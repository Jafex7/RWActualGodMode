<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Alignment bands, drift, deed values (points on a -100..+100 scale) and effects -->
  <ActualGodMode.AlignmentTuningDef>
    <defName>AGM_AlignmentTuning</defName>
    <benevolentAt>60</benevolentAt>
    <kindAt>20</kindAt>
    <sternAt>-20</sternAt>
    <wrathfulAt>-60</wrathfulAt>
    <driftPerDay>1.5</driftPerDay>

    <healColonist>1</healColonist>
    <healMercy>3</healMercy>
    <healAnimal>0.5</healAnimal>
    <feedHungry>1</feedHungry>
    <prayerAnswered>2</prayerAnswered>
    <wishGranted>1</wishGranted>
    <smiteHelplessEnemy>-5</smiteHelplessEnemy>
    <smiteOwnFollower>-10</smiteOwnFollower>
    <punishBreak>-4</punishBreak>
    <smitePrisoner>-6</smitePrisoner>
    <smiteVisitor>-8</smiteVisitor>
    <smiteColonyAnimal>-3</smiteColonyAnimal>
    <!-- dropping a pawn into fire / among hostiles: judged like a strike, times this -->
    <dangerDropFactor>1</dangerDropFactor>

    <kindGratitudeFactor>1.5</kindGratitudeFactor>
    <benevolentGratitudeFactor>2</benevolentGratitudeFactor>
    <kindPatienceRegenFactor>1.5</kindPatienceRegenFactor>
    <benevolentPatienceRegenFactor>2</benevolentPatienceRegenFactor>
    <fearFaithGain>0.03</fearFaithGain>
  </ActualGodMode.AlignmentTuningDef>

  <!-- Lightning (Smite): a real weather lightning strike -->
  <ActualGodMode.MiracleDef>
    <defName>AGM_Miracle_Lightning</defName>
    <label>lightning</label>
    <description>Lightning falls from the sky onto one person: a divine smite that leaves an unarmored enemy on the ground, and stuns machines. Armor and fire resistance soften it. Your own people only feel a sting, enough to shock them out of a break. It sets no fires. What it means depends on who is standing there: smiting attackers is just, striking down the helpless or your own people is not.</description>
    <workerClass>ActualGodMode.MiracleWorker_Lightning</workerClass>
    <gesture>AGM_Gesture_Bolt</gesture>
    <iconThing>ChunkSlagSteel</iconThing>
    <witnessFaithGain>0.02</witnessFaithGain>
    <order>40</order>
    <cost>20</cost>
    <amount>1</amount>
    <unitLabel>bolts</unitLabel>
    <!-- A charge holds `amount` bolts, one per click (ranks add bolts). -->
    <channel>
      <perClick>true</perClick>
    </channel>
    <modExtensions>
      <!-- Pinpoint: one pawn. `damage` is split into `hits` on the outer body (pain from 50 burn
           points ~94%: past a baseliner's 80% pain shock). The colony's own (colonists, slaves,
           animals, prisoners) take `ownDamage` once on the torso, never scarring. Heat armor rolls
           against each hit (minus armorPenetration); fire immunity takes it to fireResistedFactor.
           Mechs also take an EMP. No fire. First guesses (balance pass). -->
      <li Class="ActualGodMode.LightningExtension">
        <damage>50</damage>
        <hits>5</hits>
        <ownDamage>10</ownDamage>
        <armorPenetration>0.2</armorPenetration>
        <fireResistedFactor>0.5</fireResistedFactor>
        <empDamage>50</empDamage>
        <!-- vanilla kills a downed raider 50%+ of the time; a smite downs, rarely kills (-1 = vanilla) -->
        <deathOnDownedChance>0.1</deathOnDownedChance>
        <targetReach>0.9</targetReach>
        <damageDef>AGM_Smite</damageDef>
      </li>
    </modExtensions>
    <requirements>
      <li Class="ActualGodMode.Req_EventOccurred">
        <eventKey>Raid</eventKey>
        <descriptionKey>AGM_Req_Event_Raid</descriptionKey>
      </li>
    </requirements>
  </ActualGodMode.MiracleDef>

  <!-- The bolt's damage: electrical burns, resisted by heat armor (not fire: no ignition). -->
  <DamageDef>
    <defName>AGM_Smite</defName>
    <label>divine lightning</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <hasForcefulImpact>false</hasForcefulImpact>
    <makesBlood>false</makesBlood>
    <deathMessage>{0} has been struck down by divine lightning.</deathMessage>
    <hediff>ElectricalBurn</hediff>
    <armorCategory>Heat</armorCategory>
    <defaultDamage>10</defaultDamage>
    <defaultArmorPenetration>0.2</defaultArmorPenetration>
    <combatLogRules>Damage_Flame</combatLogRules>
    <canUseDeflectMetalEffect>false</canUseDeflectMetalEffect>
  </DamageDef>

  <!-- Lightning: a jagged bolt, several zigzags from top to bottom (or bottom to top).
       Kept free of a single central bar so it isn't confused with Heal's cross. -->
  <ActualGodMode.GestureDef>
    <defName>AGM_Gesture_Bolt</defName>
    <label>bolt</label>
    <templates>
      <li>
        <strokes>
          <li>
            <points>
              <li>(0.55,0)</li><li>(0.2,0.33)</li><li>(0.6,0.4)</li><li>(0.25,0.7)</li>
              <li>(0.65,0.75)</li><li>(0.35,1)</li>
            </points>
          </li>
        </strokes>
      </li>
    </templates>
  </ActualGodMode.GestureDef>

  <ThoughtDef>
    <defName>AGM_FearedWrath</defName>
    <durationDays>1</durationDays>
    <stackLimit>2</stackLimit>
    <stackedEffectMultiplier>0.75</stackedEffectMultiplier>
    <stages>
      <li>
        <label>feared the god's wrath</label>
        <description>The sky split open and someone burned. I'll do whatever it wants.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Punishment: onlookers are cowed (less likely to break, not happier) -->
  <HediffDef>
    <defName>AGM_WontBeNext</defName>
    <label>cowed</label>
    <description>Saw the god punish someone who lost control. Fear holds this person together: they are less likely to break down, for now.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.35, 0.3)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MentalBreakThreshold>-0.05</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- The smite's shock: extra pain on top of the burns, so a bolt reliably downs an unarmored
       person (pain shock). Severity = the share of the bolt's damage that got through armor and
       fire resistance; fades in about 6 hours. Painkillers and pain-immune pawns shrug it off. -->
  <HediffDef>
    <defName>AGM_LightningShock</defName>
    <label>lightning shock</label>
    <description>Struck by divine lightning. Every nerve still burns with it.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.95, 0.85, 0.4)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-4</severityPerDay>
      </li>
    </comps>
    <stages>
      <li><minSeverity>0</minSeverity><painOffset>0.1</painOffset></li>
      <li><minSeverity>0.25</minSeverity><painOffset>0.2</painOffset></li>
      <li><minSeverity>0.5</minSeverity><painOffset>0.3</painOffset></li>
      <li><minSeverity>0.75</minSeverity><painOffset>0.4</painOffset></li>
    </stages>
  </HediffDef>

  <!-- Prayer: save me from the one hunting me -->
  <ActualGodMode.PrayerRequestDef>
    <defName>AGM_Request_Smite</defName>
    <label>prayer for deliverance</label>
    <workerClass>ActualGodMode.PrayerRequestWorker_Hunted</workerClass>
    <miracle>AGM_Miracle_Lightning</miracle>
    <urgent>true</urgent>
    <mtbDays>0.1</mtbDays>
    <deadlineHours>2</deadlineHours>
    <reward>0.12</reward>
    <letterLabel>{PAWN_nameDef} prays for deliverance</letterLabel>
    <letterText>Something is coming for {PAWN_nameDef}. "Strike it down, please!"\n\nCast Lightning near {PAWN_objective} in the next {HOURS} hours to answer.</letterText>
    <alertLine>{PAWN_nameDef}: strike down the attacker</alertLine>
  </ActualGodMode.PrayerRequestDef>

</Defs>
